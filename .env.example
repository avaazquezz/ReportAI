# ─────────────────────────────────────────────────────────────────────────────
# ReportAI — Environment Variables
# Copy to .env and fill in every uncommented value before running `make up`;
# commented lines are optional.
# NEVER commit .env — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=reportai
POSTGRES_PASSWORD=change_me_strong_password_here
POSTGRES_DB=reportai

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_replace_with_a_very_long_random_secret_key_at_least_64_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Secrets at rest: bot tokens and the AI/SMTP keys entered in the panel are encrypted
#    with this. Generate it like SECRET_KEY. Empty = derived from SECRET_KEY. Changing it
#    later makes every stored secret unreadable (they must be entered again). ─────────
ENCRYPTION_KEY=change_me_another_long_random_secret

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
# true = one company per installation (what the installer sets up): the panel's setup wizard
# creates it, and its admin also manages this installation's settings. false = several
# companies under a super admin (the public demo).
SINGLE_TENANT=false
# true = anyone can create a company on a 14-day trial at /signup (the hosted service, once its
# terms and privacy policy are published). Needs SINGLE_TENANT=false: both true won't start.
# SIGNUP_ENABLED=false

# ── Error tracking (optional). Unhandled errors and ERROR log lines of the API and the worker
#    go to this Sentry DSN, without request bodies, local variables, bot tokens or email
#    addresses; ENVIRONMENT and the release are attached. Empty = nothing is sent anywhere.
#    Use a project in Sentry's EU region (its DSN ends in .ingest.de.sentry.io). ────────────
# SENTRY_DSN=

# ── Frontend / CORS ────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:3000

# ── Agent pipeline ─────────────────────────────────────────────────────────
DOCUMENT_STORAGE_PATH=/app/storage
MAX_DOCTYPE_SELECTION_ATTEMPTS=3
MAX_VALIDATION_RETRIES=3
MAX_CORRECTION_RETRIES=2
# A report still pending with no progress for this long is declared failed.
# STUCK_REPORT_MINUTES=15
# Days a voice note is kept before it is deleted (its transcript stays). 0 = forever;
# the hosted service uses 90.
# AUDIO_RETENTION_DAYS=0

# ── AI provider for extraction — chosen per installation ───────────────────
# Optional here: the setup wizard and Settings → AI in the panel store these (encrypted), and a
# value saved in the panel wins over this file.
# "anthropic" uses the Anthropic SDK. "openai_compatible" works with any OpenAI-style chat
# endpoint (OpenAI, DeepSeek, Kimi, Gemini, Groq, Mistral, Ollama...): set the base URL, key
# and model. Only providers that pass the golden set (`make eval`) are supported; any other
# is at your own risk. The client's own API key goes here.
EXTRACTION_PROVIDER=anthropic
EXTRACTION_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=change-me
# Anthropic only: low | medium | high (Haiku 4.5 rejects it). Empty = the model's default.
# EXTRACTION_EFFORT=low
# Example with another provider:
# EXTRACTION_PROVIDER=openai_compatible
# EXTRACTION_BASE_URL=https://api.deepseek.com
# EXTRACTION_API_KEY=change-me
# EXTRACTION_MODEL=deepseek-chat

# ── Transcription of voice notes — independent of the provider above ─────────
# Any OpenAI-compatible /audio/transcriptions endpoint (Groq by default). Without a key,
# text messages still work and voice notes fail with a message saying what to set.
TRANSCRIPTION_API_KEY=change-me
# TRANSCRIPTION_BASE_URL=https://api.groq.com/openai/v1
TRANSCRIPTION_MODEL=whisper-large-v3-turbo
TRANSCRIPTION_LANGUAGE=es

# ── OpenAI — landing demo audio generation only, not read by the app itself
#    (backend/scripts/generate_landing_demo_audio.py reads it directly from
#    the environment) ─────────────────────────────────────────────────────
# OPENAI_API_KEY=change_me_openai_api_key

# ── Rendering ──────────────────────────────────────────────────────────────
GOTENBERG_URL=http://gotenberg:3000

# ── SMTP delivery (report emails and password resets need it) ─────────────────
# Also configurable in the panel (Settings → Email), which wins over this file.
# Development needs nothing here: the dev compose sends every email to Mailpit
# (read them at http://localhost:8025). In production, set a real server:
# SMTP_HOST=change_me_smtp_host
# SMTP_PORT=587
# starttls (587), ssl (465) or none (a local relay only)
# SMTP_SECURITY=starttls
# SMTP_USER=change_me_smtp_user
# SMTP_PASSWORD=change_me_smtp_password
# SMTP_FROM_ADDRESS=reports@change-me.example.com

# ── WhatsApp Business Cloud API (experimental; leave unset to disable) ─────
# WHATSAPP_APP_SECRET=change_me_whatsapp_app_secret
# WHATSAPP_VERIFY_TOKEN=change_me_whatsapp_verify_token

# ── Mailgun inbound email (leave unset to disable) ─────────────────────────
# MAILGUN_API_KEY=change_me_mailgun_api_key
# MAILGUN_SIGNING_KEY=change_me_mailgun_signing_key
# MAILGUN_INBOUND_DOMAIN=inbound.change-me.example.com

# ── Production only (used by infra/docker-compose.prod.yml, Phase 4) ─────────
# APP_DOMAIN=reportai.vazquezlabs.com
# Published on /aviso-legal (LSSI art. 10) — the page flags whatever is left empty.
# LEGAL_NAME=
# LEGAL_ID=
# LEGAL_ADDRESS=
# API_ROOT_PATH=/api
# FRONTEND_ORIGIN=https://reportai.vazquezlabs.com
# Public https URL of this installation: Telegram webhooks are registered against it when a bot is saved in the panel.
# PUBLIC_BASE_URL=https://reportai.vazquezlabs.com
# Who may set X-Forwarded-For (the image default is "*"). When other projects' containers share
# Traefik's "web" network, pin Traefik's address there so they can't forge client IPs.
# FORWARDED_ALLOW_IPS=172.18.0.2

# ── Public demo (prod). DEMO_USER_EMAIL enables one-click demo login and makes
#    that account read-only. Guards: 0 = disabled. ────────────────────────────
# DEMO_USER_EMAIL=demo@reportai.dev
# DEMO_USER_PASSWORD=change_me_random
# DEMO_TELEGRAM_BOT_TOKEN=change_me_botfather_token
# DEMO_NOTIFICATION_EMAIL=demo-reports@yourdomain.com
# SENDER_RATE_LIMIT_PER_HOUR=6
# DAILY_SPEND_CAP_USD=2.0
# A channel with an empty allowed_senders list rejects everyone. Only the public demo opens it.
# ALLOW_ANY_SENDER=true
# Live demo on the landing: anyone can dictate a short visit and see it filled as a report in the
# live demo's own company (PUBLIC_DEMO_USER_EMAIL's), never approved or sent, deleted after 24 h.
# That company must NOT be the one-click demo's (DEMO_USER_EMAIL): anyone can sign into that one
# and would read other visitors' recordings. Off by default; on, it needs PUBLIC_DEMO_USER_EMAIL
# and the Spanish document type (an id of that company's types; the English one falls back to
# it). Its reports count towards that company's quota until they are deleted, so give it an active
# plan (a trial ends) of at least PUBLIC_DEMO_DAILY_LIMIT reports a month. Tries per visitor IP and
# for everyone, per 24 h (each one costs AI, about 0.04 USD); unlike the guards above, 0 here means
# no tries at all.
# PUBLIC_DEMO_ENABLED=false
# PUBLIC_DEMO_USER_EMAIL=live-demo@yourdomain.com
# PUBLIC_DEMO_DOCUMENT_TYPE_ES=
# PUBLIC_DEMO_DOCUMENT_TYPE_EN=
# PUBLIC_DEMO_PER_IP_DAILY=3
# PUBLIC_DEMO_DAILY_LIMIT=50
