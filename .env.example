# ─────────────────────────────────────────────────────────────────────────────
# ReportAI — Environment Variables
# Copy to .env and fill in ALL values before running `make up`.
# NEVER commit .env — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=reportai
POSTGRES_PASSWORD=change_me_strong_password_here
POSTGRES_DB=reportai

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_replace_with_a_very_long_random_secret_key_at_least_64_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── Agent pipeline ─────────────────────────────────────────────────────────
DOCUMENT_STORAGE_PATH=/app/storage
MAX_DOCTYPE_SELECTION_ATTEMPTS=3
MAX_VALIDATION_RETRIES=3
MAX_CORRECTION_RETRIES=2

# ── Anthropic — extraction node only ──────────────────────────────────────
ANTHROPIC_API_KEY=change_me_anthropic_api_key
EXTRACTION_MODEL=claude-sonnet-5

# ── Production only (used by infra/docker-compose.prod.yml, Phase 4) ─────────
# API_DOMAIN=api.reportai.yourdomain.com
