# SITE_ADDRESS is the installation's domain (Caddy then gets and renews its HTTPS certificate on
# its own) or ":80" for an installation reached by IP on a private network.
{$SITE_ADDRESS} {
	encode gzip

	# The API, with its /api prefix removed (the backend runs with API_ROOT_PATH=/api).
	handle_path /api/* {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
