#!/usr/bin/env bash
# Manages an installed ReportAI (see install.sh). Run on the server:
#
#   reportai status                  what is running, and which version
#   reportai logs [service]          follow the logs (backend, worker, frontend, caddy…)
#   reportai update [X.Y.Z]          update to the latest release (or to X.Y.Z)
#   reportai setup-code              a new one-time code for the setup wizard
#   reportai password-link EMAIL     a link to set a new password, when email is not set up
#   reportai restart | stop
#
# update options: --skip-backup (no database dump first), --force (allow going back a version)
set -euo pipefail

REPO="avaazquezz/ReportAI"
DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
cd "$DIR"

say() { printf '\033[1m%s\033[0m\n' "$*"; }
fail() { printf '\033[31mError: %s\033[0m\n' "$*" >&2; exit 1; }
compose() { docker compose --project-directory "$DIR" "$@"; }
setting() { grep -E "^$1=" .env | cut -d= -f2-; }

healthy() {
  for _ in $(seq 1 60); do
    compose exec -T backend curl -fsS http://localhost:8000/health > /dev/null 2>&1 && return 0
    sleep 3
  done
  return 1
}

# "1.10.0" > "1.9.3": compared as numbers, part by part.
newer() { [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)" = "$1" ] && [ "$1" != "$2" ]; }

update() {
  local target="" skip_backup=false force=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --skip-backup) skip_backup=true ;;
      --force) force=true ;;
      *) target="$1" ;;
    esac
    shift
  done
  local current
  current=$(setting REPORTAI_VERSION)
  if [ -z "$target" ]; then
    target=$(curl -fsSL "https://api.github.com/repos/$REPO/releases/latest" | grep -m1 '"tag_name"' | sed -E 's/.*"v?([^"]+)".*/\1/') \
      || fail "couldn't find the latest release on GitHub"
  fi
  target="${target#v}"
  if [ "$target" = "$current" ]; then say "Already on $current."; exit 0; fi
  if newer "$current" "$target" && [ "$force" = false ]; then
    fail "$target is older than $current. Going back doesn't undo database changes; use --force only with a backup to restore."
  fi
  say "Updating ReportAI $current → $target"

  if [ "$skip_backup" = false ]; then
    # Not a backup strategy (that is the server's own job): a way back if this update goes wrong.
    mkdir -p backups
    local dump
    dump="backups/before-$target-$(date -u +%Y%m%dT%H%M%SZ).sql.gz"
    # shellcheck disable=SC2016  # expanded inside the container, where they are set
    compose exec -T postgres sh -c 'pg_dump -U "$POSTGRES_USER" "$POSTGRES_DB"' | gzip > "$dump"
    say "Database saved to $DIR/$dump"
  fi

  for file in docker-compose.yml Caddyfile reportai; do
    if [ -n "${REPORTAI_SOURCE:-}" ]; then
      cp "$REPORTAI_SOURCE/infra/install/$file" "$file.new"
    else
      curl -fsSL "https://raw.githubusercontent.com/$REPO/v$target/infra/install/$file" -o "$file.new" \
        || fail "couldn't download $file of version $target"
    fi
  done
  mv docker-compose.yml.new docker-compose.yml
  mv Caddyfile.new Caddyfile
  chmod +x reportai.new

  sed -i -E "s/^REPORTAI_VERSION=.*/REPORTAI_VERSION=$target/" .env
  [ "${REPORTAI_NO_PULL:-}" = 1 ] || compose pull --quiet
  # The migrate service runs the database migrations before the new backend starts.
  compose up -d --remove-orphans
  if ! healthy; then
    say "The new version didn't start. Its logs:"
    compose logs --tail=40 migrate backend
    fail "update to $target failed. To go back: set REPORTAI_VERSION=$current in $DIR/.env, restore the dump in $DIR/backups, and run 'reportai restart'"
  fi
  mv reportai.new reportai  # last: this very script is being replaced
  say "ReportAI is now on $target."
}

case "${1:-help}" in
  status)
    compose ps
    echo
    echo "Version: $(setting REPORTAI_VERSION)   Address: $(setting FRONTEND_ORIGIN)"
    ;;
  logs) shift; compose logs -f --tail=100 "$@" ;;
  update) shift; update "$@" ;;
  setup-code) compose exec -T backend python -m app.cli setup-code ;;
  password-link)
    [ -n "${2:-}" ] || fail "usage: reportai password-link EMAIL"
    compose exec -T backend python -m app.cli password-link "$2"
    ;;
  restart) compose up -d --remove-orphans ;;
  stop) compose down ;;
  *) sed -n '2,12p' "$0" ;;
esac
